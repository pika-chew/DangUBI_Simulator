{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "시뮬레이터: 로컬 실행",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/dev.py", "run"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "시뮬레이터: 빌드",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/dev.py", "build"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "시뮬레이터: 필수 기능 확인",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/dev.py", "test"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "프로젝트: 개발 환경 확인",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/check_environment.py"],
      "problemMatcher": []
    },
    {
      "label": "프로젝트: 변경사항 확인",
      "type": "process",
      "command": "git",
      "args": ["status", "--short"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
