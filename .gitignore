# 개발 환경 및 빌드 산출물
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
node_modules/
dist/
build/
bin/
coverage/
*.log

# 접속 정보와 로컬 인증 자료
.env
.env.*
!.env.example
secrets/
certs/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# 로컬 실행·인프라 상태
.local/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# 로컬 대화 작업 기록·검토 자료·보조 도구 (제품 사용 안내만 공개)
