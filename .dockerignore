# 제품 빌드에 필요한 파일만 Docker 엔진에 전달한다.
**
!Dockerfile
!.dockerignore
!apps/
!apps/web/
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
!services/
!services/control/
!services/control/*.py
!services/control/requirements.lock.txt
!services/worker/
!services/worker/*.go
!services/worker/go.mod
!services/worker/go.sum
!contracts/
!contracts/*.json
**/test_*.py
**/*_test.go
**/__pycache__/**
**/*.pem
**/*.key
**/*.crt
**/*.pfx
**/*.p12
**/.env*
