# 작업 디렉터리의 비공개 .local/container.env로 복사해 값을 지정한다.
# Docker 이미지에는 이 설정 파일을 포함하지 않는다.
DANGUBI_IMAGE=dangubi-simulator:git-COMMIT_ID
DANGUBI_HTTP_PORT=8081
DANGUBI_CPUS=4
DANGUBI_MEMORY=4g
# MQTT overlay를 사용할 때만 필요하다. 인증서 내용은 쓰지 않는다.
# 이 디렉터리에 mqtt.json과 해당 인증서를 준비한다.
DANGUBI_SECRETS_DIR=C:/absolute/private/dangubi
