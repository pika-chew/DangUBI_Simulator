# EC2 x86_64 단일 호스트 수동 실행 예시. 리소스 생성·일정 생성·전송은 수행하지 않는다.
# 초기 검토 후보: 4 vCPU / 16GiB 호스트. 처리량·7일 연속 실행 보장값이 아니다.
# 검증 후 확정한 ECR 이미지 digest로 교체한다. 인증서·AWS 자격증명을 넣지 않는다.
DANGUBI_IMAGE=ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com/dangubi-simulator@sha256:VERIFIED_DIGEST
DANGUBI_HTTP_PORT=8081
DANGUBI_CPUS=4
# 호스트 OS·Docker용 메모리 여유를 남긴다. 기존 로컬 기본값은 바꾸지 않는다.
DANGUBI_MEMORY=12g
DANGUBI_SECRETS_DIR=/opt/dangubi/private
