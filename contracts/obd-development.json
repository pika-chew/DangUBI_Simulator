                "minimum": 0
              },
              "fc": {
                "type": "number",
                "title": "연료소모량 · 단위 미확정",
                "default": 120,
                "minimum": 0
              },
              "stlat": {
                "type": "number",
                "title": "시작 위도",
                "default": 37.5,
