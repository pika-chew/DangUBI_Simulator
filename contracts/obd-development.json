                "minimum": 0
              },
              "stt": {
                "type": "integer",
                "title": "운행 시작 · UTC 밀리초",
                "default": 1794780000000,
                "minimum": 0,
                "maximum": 9000000000000000
              },
              "edt": {
                "type": "integer",
                "title": "운행 종료 · UTC 밀리초",
