{
  "profile_version": "obd-development-0.2",
  "status": "개발용 잠정 규격 · 수신 호환성 미확정",
  "profiles": {
    "4": {
      "title": "OBD Microtrip",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ty",
          "ts",
          "pld"
        ],
        "properties": {
          "ty": {
            "const": 4,
            "type": "integer"
          },
          "ts": {
            "type": "integer",
            "title": "메시지 시각 · UTC 밀리초",
            "default": 1794783600000,
            "minimum": 0,
            "maximum": 9000000000000000
          },
          "pld": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tid",
              "lat",
              "lon",
              "clt",
              "em"
            ],
            "properties": {
              "tid": {
                "type": "integer",
                "title": "운행 번호",
                "default": 1,
                "minimum": 0
              },
              "lat": {
                "type": "number",
                "title": "위도",
                "default": 37.5,
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "title": "경도",
                "default": 127.0,
                "minimum": -180,
                "maximum": 180
              },
              "clt": {
                "type": "integer",
                "title": "수집 시각 · UTC 밀리초",
                "default": 1794783600000,
                "minimum": 0,
                "maximum": 9000000000000000
              },
              "fc": {
                "type": "number",
                "title": "연료소모량 · 단위 미확정",
                "default": 12,
                "minimum": 0
              },
              "lc": {
                "type": "number",
                "title": "위치 정확도",
                "default": 5,
                "minimum": 0
              },
              "cdit": {
                "type": "number",
                "title": "운행 누적거리 (m)",
                "default": 1200,
                "minimum": 0
              },
              "rpm": {
                "type": "integer",
                "title": "RPM",
                "default": 1200,
                "minimum": 0
              },
              "sp": {
                "type": "number",
                "title": "속도 (km/h · 개발 기준)",
                "default": 30,
                "minimum": 0
              },
              "em": {
                "type": "integer",
                "title": "주기 내 이벤트 · bit8 과속은 시뮬레이터 확장",
                "default": 0,
                "minimum": 0,
                "maximum": 383,
                "anyOf": [
                  {
                    "maximum": 127
                  },
                  {
                    "minimum": 256
                  }
                ]
              },
              "el": {
                "type": "number",
                "title": "엔진 부하 (%)",
                "default": 25,
                "minimum": 0,
                "maximum": 100
              },
              "xyz": {
                "type": "string",
                "title": "가속도·각속도 · 단위 미확정",
                "default": "0,0,0",
                "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?$",
                "maxLength": 120
              },
              "vv": {
                "type": "number",
                "title": "배터리 전압 (V · 개발 기준)",
                "default": 12.6,
                "minimum": 0
              },
              "tpos": {
                "type": "number",
                "title": "스로틀 (%)",
                "default": 15,
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      },
      "example": {
        "ty": 4,
        "ts": 1794783600000,
        "pld": {
          "tid": 1,
          "lat": 37.5,
          "lon": 127.0,
          "clt": 1794783600000,
          "rpm": 1200,
          "sp": 30,
          "el": 25,
          "vv": 12.6,
          "em": 0
        }
      }
    },
    "3": {
      "title": "OBD Trip",
