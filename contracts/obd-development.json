          "ty",
          "ts",
          "pld"
        ],
        "properties": {
          "ty": {
            "const": 3,
            "type": "integer"
          },
          "ts": {
            "type": "integer",
            "title": "메시지 시각 · UTC 밀리초",
            "default": 1794783600000,
            "minimum": 0,
            "maximum": 9000000000000000
          },
          "pld": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tid",
