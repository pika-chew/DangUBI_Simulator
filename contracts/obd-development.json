              "idt": {
                "type": "number",
                "title": "공회전 시간 · 단위 미확정",
                "default": 60,
                "minimum": 0
              },
              "btv": {
                "type": "number",
                "title": "시동 OFF 전압",
                "default": 12.6,
                "minimum": 0
              },
              "gnv": {
                "type": "number",
                "title": "발전기 전압",
                "default": 14.2,
                "minimum": 0
              },
              "wut": {
                "type": "number",
                "title": "웜업 시간 · 단위 미확정",
                "default": 30,
                "minimum": 0
              },
              "usm": {
                "type": "integer",
                "title": "연결 휴대폰 번호 · 가상값만",
                "default": 0,
                "minimum": 0
              },
              "est": {
                "type": "number",
                "title": "80~100km 운행시간 · 단위 미확정",
                "default": 10,
                "minimum": 0
              },
              "fwv": {
                "type": "string",
                "title": "펌웨어 버전 · 자료형 미확정",
